# Supabase Project Configuration
# Ambil dari Supabase dashboard: Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Publishable key (format baru, diawali `sb_publishable_`). Ini yang dipakai.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Opsional: anon JWT lama, dipakai hanya kalau PUBLISHABLE_KEY kosong.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Freshness AI API (FastAPI di Cloud Run, lihat ../freshness-api).
# Kalau kosong, tangkapan tetap tersimpan tapi tanpa grade kesegaran.
# FRESHNESS_API_URL=https://freshness-api-xxxx.a.run.app
